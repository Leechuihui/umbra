# Linguist detection
*.rs linguist-detectable=false
*.css linguist-detectable=false
*.mdx linguist-detectable=false
*.txt linguist-detectable=false
*.sh linguist-detectable=false
*.s linguist-detectable=false
*.bat linguist-detectable=false
*.html linguist-detectable=false

# Line endings — force LF for scripts so they run on Linux/macOS after clone
*.sh    text eol=lf
*.py    text eol=lf
*.conf  text eol=lf
*.service text eol=lf

# Windows batch files need CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
